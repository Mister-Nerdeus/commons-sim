{
  "name": "@commons-sim/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "commons-sim": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch src/main.ts",
    "test": "c8 --reporter=text-summary --check-coverage --lines 60 --functions 45 --branches 50 --statements 60 node --test dist/test.js dist/determinism.test.js dist/integration.test.js dist/canonical.test.js",
    "lint": "echo \"(add eslint later)\"",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "determinism:init": "node dist/determinismInit.js",
    "determinism:check": "node dist/determinismCheck.js",
    "determinism:baseline": "node dist/determinismCheck.js"
  },
  "dependencies": {
    "@commons-sim/engine": "workspace:*",
    "@commons-sim/shared": "workspace:*"
  }
}
