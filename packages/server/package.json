{
  "name": "@commons-sim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node dist/main.js",
    "test": "c8 --reporter=text-summary --check-coverage --lines 60 --functions 60 --branches 50 --statements 60 node --test dist/server.test.js",
    "lint": "echo \"(add eslint later)\"",
    "format": "prettier -w .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/migrate.js",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs"
  },
  "dependencies": {
    "@commons-sim/engine": "workspace:*",
    "@commons-sim/shared": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
