{
  "name": "commons-sim",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "20.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "determinism:init": "pnpm --filter @commons-sim/cli... build && node packages/cli/dist/determinismInit.js",
    "determinism:check": "pnpm --filter @commons-sim/cli... build && node packages/cli/dist/determinismCheck.js",
    "determinism:baseline": "pnpm determinism:check",
    "smoke:cli": "pnpm --filter @commons-sim/cli... build && node packages/cli/dist/main.js run scenarios/baseline-48.json",
    "dev:web": "pnpm --filter @commons-sim/web dev",
    "dev:cli": "pnpm --filter @commons-sim/cli dev"
  },
  "devDependencies": {
    "@types/node": "^20.17.58",
    "c8": "^10.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
